# GitWise Environment Variables Example
# Copy this file to .env and configure your credentials.

# GitHub Personal Access Token (optional, for higher rate limits on live repos)
GITHUB_TOKEN=your_github_token_here

# LLM Provider Keys (optional, fallback deterministic grounder runs offline by default)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Local SQLite Database Path
GITWISE_DB_PATH=gitwise_runs.db
